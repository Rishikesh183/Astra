# Physics Witness settings. Copy to .env and fill in; .env is git-ignored.
#   cp .env.example .env
# Every value can also be set as a normal environment variable (for Docker: --env-file .env).

# ---------------------------------------------------------------------------
# Required for real results
# ---------------------------------------------------------------------------

# Nebius Token Factory API key (starts with "v1."). Without it everything runs
# in offline stub mode: the video is sampled, but every verdict is "Can't tell".
NEBIUS_API_KEY=

# Tavily API key, for weather on the claim date and facts about the place.
# Optional: without it the weather/place lookup is skipped.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Models (leave empty to auto-discover from Token Factory's /models list;
# `physics-witness checks` prints what it found)
# ---------------------------------------------------------------------------

# Token Factory's OpenAI-compatible base URL. Change it only if your project uses a different one.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Vision model that reads the frames (the Cosmos reasoner)
PW_COSMOS_MODEL=
# Judge for the cross-examination (Nemotron Ultra)
PW_ULTRA_MODEL=
# Small model that splits stories and writes evidence requests (Nemotron Nano or Super)
PW_SPLITTER_MODEL=
# Nemotron Super (the judge under the budget policy)
PW_SUPER_MODEL=

# quality = Ultra judges; budget = Super judges (cheaper)
PW_POLICY=quality

# ---------------------------------------------------------------------------
# Cost meter
# ---------------------------------------------------------------------------

# USD per 1M tokens per model: cp pricing.example.json pricing.json and fill it
# from https://tokenfactory.nebius.com/organization/prices
PW_PRICES_FILE=pricing.json

# ---------------------------------------------------------------------------
# Local behaviour
# ---------------------------------------------------------------------------

# Every model response is cached here, so re-runs and demo recordings cost nothing.
PW_CACHE_DIR=.cache/responses
# 1 = never call the network (deterministic stub replies; used by the tests)
PW_OFFLINE=0

# ---------------------------------------------------------------------------
# Where videos go (these are paths, not settings; listed here for reference)
# ---------------------------------------------------------------------------
#   liartest/clips/    Liar Test clips; one row per clip in liartest/cases.csv
#   data/claims/       claims made in the web app or with `physics-witness add`
#   samples/           quick one-off tries with `physics-witness run`
