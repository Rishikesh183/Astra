# Nebius Token Factory (key starts with "v1.")
NEBIUS_API_KEY=
# Override if the Token Factory base URL differs for your project
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Leave model names empty to auto-discover from /models (see `physics-witness checks`)
PW_COSMOS_MODEL=
PW_ULTRA_MODEL=
PW_SPLITTER_MODEL=
TAVILY_API_KEY=
# 1 = never call the network; deterministic stub responses (used by tests)
PW_OFFLINE=0
PW_CACHE_DIR=.cache/responses
